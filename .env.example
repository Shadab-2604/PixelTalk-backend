# ============================================================
# PIXELTALK BACKEND ENVIRONMENT VARIABLES (.env.example)
# ============================================================

# Environment mode ('production' or 'development')
NODE_ENV=production

# Server port (Render will inject PORT automatically, default: 5000)
PORT=5000

# MongoDB Atlas connection string (include database name in URI or Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pixeltalk?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pixeltalk?retryWrites=true&w=majority

# JWT Cryptographic Secret (use a 64+ char random hex string in production: `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-very-long-random-secret-key-for-production-use

# JWT Expiration duration (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS and credentials (comma-separated, no trailing slashes)
# Example: https://pixel-talk-cyan.vercel.app,http://localhost:3000
CLIENT_URL=https://pixel-talk-cyan.vercel.app,http://localhost:3000

# Platform Administrator Account (Seeded / updated on server startup)
ADMIN_EMAIL=admin@pixeltalk.dev
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=admin123456

# Transactional Email (Brevo / Sendinblue HTTPS REST API)
# Get a free API key at: https://app.brevo.com/settings/keys/api
# Free tier: 300 emails/day, no credit card required, works 100% on Render over port 443
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=PixelTalk <your_verified_brevo_email@gmail.com>

# Cloudinary Media Storage (Avatars, Lounge Banners, Chat Images)
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Maximum file upload size in Megabytes (default: 25)
MAX_FILE_SIZE_MB=25
